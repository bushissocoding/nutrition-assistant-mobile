# Copy this file to .env and replace the address with one reachable by your app target.
# Physical phone: use the development computer's LAN IPv4 address.
# Android Emulator: use http://10.0.2.2:4000
# iOS Simulator on the same Mac as the API: use http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
