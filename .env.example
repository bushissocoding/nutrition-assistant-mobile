# Expo-only settings. EXPO_PUBLIC_* values are embedded in the client bundle; never put secrets here.
# Copy this file to .env only when one does not already exist, then set a reachable API address.
# Physical phone: use the development computer's LAN IPv4 address.
# Android Emulator: use http://10.0.2.2:4000
# iOS Simulator on the same Mac as the API: use http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public Supabase values for managed identity only; these values are embedded in the app bundle.
# Leave empty until a Supabase project has been created. Never put a secret key here.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
