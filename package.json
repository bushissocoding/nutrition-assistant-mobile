{
  "name": "nutrition-assistant-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "app/App.js",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0 <25 || >=26.0.0",
    "npm": ">=10.9.0 <12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api": "node --env-file-if-exists=server/.env server/server.js",
    "api:dev": "node --env-file-if-exists=server/.env --watch server/server.js",
    "push:worker": "node --env-file-if-exists=server/.env server/push-worker.js",
    "test:api": "node server/server.test.js",
    "test:supabase-api": "node server/integration/account-flow.js",
    "test:unit": "node --test server/tests/*.test.js app/src/features/profile/profile-model.test.cjs app/src/features/onboarding/consent-model.test.cjs app/src/features/diary/diary-history.test.cjs app/src/features/home/home-calendar.test.cjs app/src/services/health-record-ocr.test.cjs app/src/services/push-device-storage.test.cjs app/src/services/auth-session-storage.test.cjs app/src/services/identity-model.test.cjs app/src/services/auth-service.test.cjs app/src/services/api-config.test.cjs app/src/services/demo-namespace-storage.test.cjs app/src/services/api-client.test.cjs app/src/app/purge-before-local-delete.test.cjs",
    "test:ui": "jest --runInBand",
    "catalog:validate": "node server/scripts/import-food-catalog.js --input server/data/foods.json --check --allow-legacy",
    "catalog:fixture": "node server/scripts/import-food-catalog.js --input server/data/fixtures/synthetic-foods.json --check",
    "catalog:import": "node server/scripts/import-food-catalog.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.0",
    "expo-ai-kit": "^0.19.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-splash-screen": "~58.0.14",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "express": "^4.22.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-runtime": "~58.0.17",
    "@testing-library/react-native": "^13.3.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "19.3.0"
  }
}
