# API-only local development settings. Keep demo persistence disabled unless explicitly needed.
PORT=4000
CORS_ORIGIN=*
DEMO_DATA_ENABLED=false
DEMO_DATA_FILE=server/.local-data/demo-store.json

# Optional server-only USDA FoodData Central API key for sourced live search.
# Never use this in an EXPO_PUBLIC_* variable or commit a real key.
# FDC_API_KEY=

# Supabase server settings. Use current publishable/secret keys from the project Connect panel.
# The secret key bypasses RLS and must never be placed in the mobile app or a public environment file.
# Leave empty for local demo/API-only development. Production requires all three settings.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional PayOS merchant integration. Checkout is disabled unless every setting is provided.
# Configure the HTTPS URLs in your merchant account and keep all keys server-only.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=https://app.example.test/payments/return
# PAYOS_CANCEL_URL=https://app.example.test/payments/cancel
# PAYOS_WEBHOOK_URL=https://api.example.test/api/v1/webhooks/payos

# Optional server-only OpenAI Responses API adapter for the explicitly consented assistant.
# The model and key must be configured together; the mobile app never receives this key.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional: Expo Push access token. Keep it server-only; required by the push worker.
# EXPO_PUSH_ACCESS_TOKEN=
